<!DOCTYPE html>
<html lang="km">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PHANIT T-SHIRT | Future Fashion 7000 AD</title>
    <link rel="stylesheet" href="styles.css">
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Syncopate:wght@400;700&family=Rajdhani:wght@300;500;700&display=swap" rel="stylesheet">
</head>
<body>
    <!-- Quantum Particle Background -->
    <canvas id="quantum-canvas"></canvas>
    <div class="holographic-grid"></div>
    
    <!-- Neural Cursor -->
    <div class="neural-cursor"></div>
    <div class="cursor-trail"></div>

    <!-- Header -->
    <header class="neural-header">
        <div class="logo-container">
            <div class="logo-hologram">
                <span class="logo-symbol">◉</span>
                <div class="logo-rings">
                    <span></span><span></span><span></span>
                </div>
            </div>
            <div class="logo-text">
                <h1>PHANIT</h1>
                <span class="logo-sub">T-SHIRT</span>
                <div class="logo-scan-line"></div>
            </div>
        </div>
        
        <nav class="neural-nav">
            <ul>
                <li><a href="#singularity" class="nav-link" data-text="HOME">HOME</a></li>
                <li><a href="#collection" class="nav-link" data-text="COLLECTION">COLLECTION</a></li>
                <li><a href="#matrix" class="nav-link" data-text="AI-ORDER">AI-ORDER</a></li>
            </ul>
            <div class="nav-indicator"></div>
        </nav>
        
        <div class="header-status">
            <span class="status-dot"></span>
            <span class="status-text">SYSTEM ONLINE</span>
            <span class="time-display" id="future-time">Y:7000</span>
        </div>
    </header>

    <!-- Hero Section: Singularity -->
    <section id="singularity" class="singularity-hero">
        <div class="hero-perspective">
            <div class="floating-pyramid">
                <div class="pyramid-face front">P</div>
                <div class="pyramid-face back">H</div>
                <div class="pyramid-face right">A</div>
                <div class="pyramid-face left">N</div>
                <div class="pyramid-face top">I</div>
                <div class="pyramid-face bottom">T</div>
            </div>
        </div>
        
        <div class="hero-content">
            <div class="glitch-container">
                <h2 class="mega-title" data-text="PHANIT T-SHIRT">PHANIT T-SHIRT</h2>
                <div class="scanlines"></div>
            </div>
            <p class="hero-tagline">
                <span class="typewriter-text">Quantum Fabric Technology</span>
                <span class="cursor-blink">_</span>
            </p>
            <p class="hero-description">
                បច្ចេកវិទ្យាអនាគត 7000 AD • Nano-Fiber Adaptive • Holographic Weave
            </p>
            
            <div class="hero-cta-group">
                <a href="#collection" class="quantum-button primary">
                    <span class="btn-text">INITIALIZE SHOPPING</span>
                    <span class="btn-particles"></span>
                    <div class="btn-hologram"></div>
                </a>
                <div class="hologram-card">
                    <div class="card-content">
                        <span class="card-icon">◈</span>
                        <span class="card-text">LIVE INVENTORY</span>
                        <span class="card-value" id="inventory-count">∞</span>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="hero-visualizer">
            <div class="orbital-ring ring-1"></div>
            <div class="orbital-ring ring-2"></div>
            <div class="orbital-ring ring-3"></div>
            <div class="core-orb"></div>
        </div>
    </section>

    <!-- Collection Section -->
    <section id="collection" class="quantum-collection">
        <div class="section-header">
            <h2 class="section-title holographic-text">QUANTUM COLLECTION</h2>
            <div class="title-decoration">
                <span class="deco-line"></span>
                <span class="deco-orb">◉</span>
                <span class="deco-line"></span>
            </div>
            <p class="section-subtitle">Select your dimensional attire</p>
        </div>

        <div class="holographic-showcase">
            <!-- Product 1: Void Walker -->
            <div class="product-void" data-product="void-walker">
                <div class="void-frame">
                    <div class="product-hologram">
                        <div class="holo-model void-model">
                            <div class="model-layers">
                                <span class="layer">◈</span>
                                <span class="layer">◈</span>
                                <span class="layer">◈</span>
                            </div>
                            <div class="model-glow"></div>
                        </div>
                        <div class="holo-reflection"></div>
                    </div>
                    <div class="void-info">
                        <div class="info-glow"></div>
                        <h3 class="product-name">VOID WALKER</h3>
                        <p class="product-class">Class: Interdimensional</p>
                        <p class="product-specs">Dark Matter Thread • Shadow Weave</p>
                        <div class="price-matrix">
                            <span class="price-value" data-value="888">888</span>
                            <span class="price-unit">$GC</span>
                            <div class="price-hologram"></div>
                        </div>
                        <button class="quantum-buy" onclick="initiatePurchase('Void Walker', 888)">
                            <span class="buy-text">MATERIALIZE</span>
                            <span class="buy-icon">→</span>
                        </button>
                    </div>
                    <div class="void-particles"></div>
                </div>
            </div>

            <!-- Product 2: Neon Genesis -->
            <div class="product-void featured" data-product="neon-genesis">
                <div class="void-frame">
                    <div class="featured-badge">PRIME</div>
                    <div class="product-hologram">
                        <div class="holo-model neon-model">
                            <div class="model-layers">
                                <span class="layer">⚡</span>
                                <span class="layer">⚡</span>
                                <span class="layer">⚡</span>
                            </div>
                            <div class="model-glow"></div>
                        </div>
                        <div class="holo-reflection"></div>
                    </div>
                    <div class="void-info">
                        <div class="info-glow neon-glow"></div>
                        <h3 class="product-name">NEON GENESIS</h3>
                        <p class="product-class">Class: Luminescent</p>
                        <p class="product-specs">Plasma Fiber • Bio-Luminescent</p>
                        <div class="price-matrix">
                            <span class="price-value" data-value="1200">1200</span>
                            <span class="price-unit">$GC</span>
                            <div class="price-hologram neon-holo"></div>
                        </div>
                        <button class="quantum-buy neon" onclick="initiatePurchase('Neon Genesis', 1200)">
                            <span class="buy-text">MATERIALIZE</span>
                            <span class="buy-icon">→</span>
                        </button>
                    </div>
                    <div class="void-particles neon-particles"></div>
                </div>
            </div>

            <!-- Product 3: Cyber Monk -->
            <div class="product-void" data-product="cyber-monk">
                <div class="void-frame">
                    <div class="product-hologram">
                        <div class="holo-model monk-model">
                            <div class="model-layers">
                                <span class="layer">☯</span>
                                <span class="layer">☯</span>
                                <span class="layer">☯</span>
                            </div>
                            <div class="model-glow"></div>
                        </div>
                        <div class="holo-reflection"></div>
                    </div>
                    <div class="void-info">
                        <div class="info-glow monk-glow"></div>
                        <h3 class="product-name">CYBER MONK</h3>
                        <p class="product-class">Class: Techno-Spiritual</p>
                        <p class="product-specs">Zen Circuit • Meditation Fiber</p>
                        <div class="price-matrix">
                            <span class="price-value" data-value="666">666</span>
                            <span class="price-unit">$GC</span>
                            <div class="price-hologram monk-holo"></div>
                        </div>
                        <button class="quantum-buy monk" onclick="initiatePurchase('Cyber Monk', 666)">
                            <span class="buy-text">MATERIALIZE</span>
                            <span class="buy-icon">→</span>
                        </button>
                    </div>
                    <div class="void-particles monk-particles"></div>
                </div>
            </div>
        </div>
    </section>

    <!-- AI Order Matrix -->
    <section id="matrix" class="ai-matrix">
        <div class="matrix-container">
            <div class="matrix-header">
                <h2 class="matrix-title">NEURAL ORDER MATRIX</h2>
                <div class="matrix-status">
                    <span class="status-indicator"></span>
                    <span>AI PROCESSOR ACTIVE</span>
                </div>
            </div>

            <div class="matrix-interface">
                <!-- Selected Product Display -->
                <div class="selection-display" id="selectionDisplay">
                    <div class="display-hologram">
                        <span class="display-icon">◉</span>
                        <div class="display-scan"></div>
                    </div>
                    <div class="display-info">
                        <span class="display-label">TARGET ACQUIRED</span>
                        <span class="display-value" id="selectedItem">AWAITING SELECTION...</span>
                        <span class="display-price" id="selectedPrice">-- $GC</span>
                    </div>
                    <div class="display-waves"></div>
                </div>

                <!-- Neural Form -->
                <form id="neuralForm" class="neural-form">
                    <div class="form-grid">
                        <!-- Identity Module -->
                        <div class="form-module identity-module">
                            <div class="module-header">
                                <span class="module-icon">◈</span>
                                <span class="module-title">IDENTITY MODULE</span>
                            </div>
                            <div class="input-neural">
                                <input type="text" id="customerName" required placeholder=" ">
                                <label>Designation / ឈ្មោះ</label>
                                <div class="input-glow"></div>
                                <div class="input-border"></div>
                            </div>
                            <div class="input-neural">
                                <input type="tel" id="phone" required placeholder=" ">
                                <label>Comm Link / លេខទូរស័ព្ទ</label>
                                <div class="input-glow"></div>
                                <div class="input-border"></div>
                            </div>
                        </div>

                        <!-- Location Module -->
                        <div class="form-module location-module">
                            <div class="module-header">
                                <span class="module-icon">◎</span>
                                <span class="module-title">COORDINATES</span>
                            </div>
                            <div class="input-neural full-width">
                                <textarea id="address" required placeholder=" " rows="3"></textarea>
                                <label>Delivery Coordinates / អាសយដ្ឋាន</label>
                                <div class="input-glow"></div>
                                <div class="input-border"></div>
                            </div>
                        </div>

                        <!-- Upload Module -->
                        <div class="form-module upload-module">
                            <div class="module-header">
                                <span class="module-icon">◉</span>
                                <span class="module-title">DATA UPLOAD</span>
                            </div>
                            <div class="quantum-upload" id="quantumUpload">
                                <input type="file" id="receipt" accept="image/*" required>
                                <div class="upload-field">
                                    <div class="upload-hologram">
                                        <div class="holo-ring ring-1"></div>
                                        <div class="holo-ring ring-2"></div>
                                        <div class="holo-icon">📡</div>
                                    </div>
                                    <p class="upload-text">Initialize File Transfer</p>
                                    <p class="upload-sub">Drop holographic receipt or neural-tap to browse</p>
                                    <div class="upload-progress" id="uploadProgress"></div>
                                </div>
                                <div class="upload-preview" id="uploadPreview">
                                    <img src="" alt="Holographic Preview" id="previewImg">
                                    <div class="preview-overlay">
                                        <span class="preview-status">VERIFIED</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Submit Core -->
                    <div class="submit-core">
                        <button type="submit" class="neural-submit" id="neuralSubmit">
                            <div class="submit-hologram">
                                <span class="holo-ring"></span>
                                <span class="holo-ring"></span>
                                <span class="holo-ring"></span>
                            </div>
                            <span class="submit-text">INITIATE QUANTUM TRANSFER</span>
                            <div class="submit-particles"></div>
                        </button>
                        <div class="submit-trail"></div>
                    </div>
                </form>
            </div>
        </div>
    </section>

    <!-- Quantum Notifications -->
    <div id="quantumAlert" class="quantum-alert">
        <div class="alert-container">
            <div class="alert-hologram">
                <div class="alert-ring"></div>
                <div class="alert-icon">◉</div>
            </div>
            <div class="alert-content">
                <h3 class="alert-title">TRANSMISSION COMPLETE</h3>
                <p class="alert-message">Order successfully transmitted to neural network</p>
                <div class="alert-code">ID: <span id="orderId">QT-7000-∞</span></div>
            </div>
            <div class="alert-waves">
                <span></span><span></span><span></span>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="neural-footer">
        <div class="footer-grid">
            <div class="footer-brand">
                <span class="brand-symbol">◉</span>
                <span>PHANIT T-SHIRT</span>
                <div class="brand-line"></div>
            </div>
            <div class="footer-temporal">
                <span>Temporal Coordinate: 7000 AD</span>
                <span>Galactic Sector: Orion Arm</span>
            </div>
        </div>
        <div class="footer-scan"></div>
    </footer>

    <script src="script.js"></script>
</body>
</html>
